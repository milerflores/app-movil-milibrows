# Dispositivo fisico: usar la IP LAN de la PC donde se ejecuta Laravel.
# Emulador Android: http://10.0.2.2:8000/api/v1
# Web o simulador iOS local: http://localhost:8000/api/v1
# En desarrollo se detecta la IP del servidor Expo si no se especifica esta variable.
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8000/api/v1
# Proxy de la vista previa web (no afecta la app nativa):
# API_PROXY_TARGET=http://localhost:8000
# En produccion nativa, definir una URL HTTPS real:
# EXPO_PUBLIC_API_URL=https://api.tu-estudio.com/api/v1
