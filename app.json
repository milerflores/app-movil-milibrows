{
  "expo": {
    "name": "MiliBrows",
    "slug": "milibrows-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "scheme": "milibrowsapp",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.milibrows.clientes"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F5",
        "foregroundImage": "./assets/brand/app-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.milibrows.clientes"
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/brand/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8F5",
          "image": "./assets/brand/logo.png",
          "imageWidth": 220
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
